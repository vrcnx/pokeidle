# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ─────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Local env / secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example is committed (template only)

# ── Prisma local dev DB ──────────────────────────────────────────────────
server/prisma/dev.db
server/prisma/dev.db-journal
# NOTE: prisma/migrations is deliberately NOT ignored. Migrations are
# source code — they are the schema's history and the exact thing the
# deploy applies (`prisma migrate deploy`). Ignoring them is why the
# deploy previously had to use `db push --accept-data-loss`, which
# could silently drop live columns. Commit them alongside the schema
# change that produced them. See server/prisma/migrations/README.md.

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS junk ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ── Claude Code session data ─────────────────────────────────────────────
.claude/scheduled_tasks.json
.claude/sessions/
.claude/cache/

# ── Personal art assets / one-off scripts ────────────────────────────────
# 16 MB Photoshop background template — kept out of git so the repo
# stays cloneable on slow links. Drop a copy into the repo locally if
# you need to edit; just don't commit it.
background-template.psd
# Personal background-generation scripts — they read a token from a
# hardcoded local path (~/.claude/skills/generate-image/.token) so they
# don't make sense for other contributors. Excluded.
bg_poll.py
bg_submit.py

# ── Recovery snapshots ───────────────────────────────────────────────────
recovered/

# ── Misc ─────────────────────────────────────────────────────────────────
*.tmp
.cache/
coverage/

# One-time PokeAPI responses for scripts/gen-gen3.mjs. A cache, not data —
# the numbers it holds are written into src/data/gen3/* and committed there.
game/.gen3-pokeapi-cache.json

# One-time PokeAPI pulls for the Hoenn generators. Caches, not data — what
# they hold is written into src/data/regions/hoenn/* and committed there.
game/.hoenn-enc-cache.json
game/.hoenn-real-encounters.json
game/.hoenn-art-failed.txt

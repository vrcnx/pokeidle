# Database — use SQLite locally, swap to Railway Postgres URL in prod.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:8787"

# Frontend origin (CORS + cookies)
FRONTEND_ORIGIN="http://localhost:5173"

# Google OAuth (optional — leave blank to disable Google login)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server port
PORT=8787

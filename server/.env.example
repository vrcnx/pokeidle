# Database — use SQLite locally, swap to Railway Postgres URL in prod.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:8787"

# Frontend origin (CORS + cookies)
FRONTEND_ORIGIN="http://localhost:5173"

# Google OAuth (optional — leave blank to disable Google login)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server port
PORT=8787

# Trust the X-Forwarded-For header for rate-limit IP resolution.
# Set to "true" ONLY in deployments where a known proxy (Railway,
# Vercel, Cloudflare, nginx) terminates TLS and appends a verified
# client-IP entry. When false, the auth limiter uses the raw socket
# address so attackers can't spoof X-Forwarded-For to bypass.
TRUSTED_PROXY="false"

# Admin machine auth (optional — leave blank to disable entirely).
#
# When set, callers may authenticate to /api/admin/* by sending
#   x-admin-key: <this value>
# instead of a browser session cookie. This is what powers
# `server/scripts/admin.ts` (tournament ops, announcements, bans) and
# any cron/agent automation.
#
# Rules the server enforces:
#   * Blank/unset  → the header is ignored completely. No bypass exists.
#   * < 32 chars   → refused as misconfiguration, logged, never honoured.
#   * The key does not create an identity. It ACTS AS the admin named in
#     ADMIN_API_KEY_USERNAME (or the oldest admin if unset). If that user
#     is not an admin, the call is refused — so demoting them revokes the
#     key. Every action is audited with via:"api-key".
#
# Generate with:  openssl rand -hex 32
# Treat this like a root password. Never commit the real value.
ADMIN_API_KEY=""
ADMIN_API_KEY_USERNAME=""

# ── Discord bot (optional — leave blank to disable the bot API entirely) ──
#
# Shared secret authenticating the standalone `bot/` service to /api/bot.
# Must MATCH the BOT_TOKEN set on the bot service.
#
# Rules the server enforces:
#   * Blank/unset  → /api/bot answers 401 to everything. FAILS CLOSED: an
#     unset token never means "no auth required". No dev fallback exists.
#   * < 32 chars   → refused as misconfiguration, logged (never the value),
#     never honoured. Same rule as ADMIN_API_KEY, because this surface reads
#     player data.
#   * Bearer form only: `Authorization: Bearer <token>`.
#
# What it grants: read-only player data (trainer cards, ladder, party),
# Discord account linking, giveaway creation/draw, and trade LISTINGS. It
# cannot move a Pokémon, an item or money between accounts — there is no
# endpoint for it — and it cannot write saveData. Prizes go through the
# PendingGrant inbox like every other grant.
#
# Rotating it: set the new value here, restart the server, set the same value
# on the bot, restart the bot. Commands answer "I'm not authorised" in between
# and nothing player-facing breaks. See bot/README.md.
#
# Generate with:  openssl rand -hex 32
BOT_TOKEN=""

# Account level at which the bot grants the Ace Trainer role. Account level
# rather than PvP rating on purpose — see lib/discordRoles.ts. Default 25.
DISCORD_ACE_TRAINER_LEVEL="25"

# Rated matches required before anyone is awarded Champion. Without a floor,
# "#1 on the ladder" is whoever most recently won a single game. Default 5.
DISCORD_CHAMPION_MIN_MATCHES="5"

# ── "Link your Discord, get a prize" promotion ────────────────────────
#
# The PRIZE is NOT configured here. It lives in the database (DiscordConfig)
# and is edited in the admin dashboard → Giveaways → "Discord link reward",
# using the same prize picker as a giveaway. That is deliberate: it is
# promotion content an operator changes as a judgement call, and env would put
# it behind a redeploy, somewhere the dashboard cannot show it.
#
# It is paid ONCE per game account and ONCE per Discord account, through the
# PendingGrant inbox. Idempotency needs no extra table: PendingGrant is
# append-only and indexed on (source, sourceId), so the grant IS the receipt,
# and it survives unlink-then-relink in both directions.
#
# WHAT IT DOES NOT BLOCK: N throwaway Discord accounts paired with N throwaway
# game accounts. Nothing short of an eligibility gate does. To check whether it
# is being farmed:
#   SELECT date_trunc('day',"createdAt"), count(*) FROM "PendingGrant"
#   WHERE source = 'discord-link' GROUP BY 1 ORDER BY 1 DESC;

# The one part that DOES stay in env: an optional account-level gate on the
# reward. 0 (the default) = no gate, which is the shipped behaviour. It lives
# here rather than in the dashboard on purpose — the prize is content, but this
# is a policy lever, and it should be harder to move than a text box on a page
# anyone with admin can reach.
DISCORD_LINK_REWARD_MIN_LEVEL="0"

# 24/7 Twitch renderer (optional). Shared secret authenticating the standalone
# `renderer/` service to /api/internal/broadcast/*. Blank/unset or < 16 chars →
# the internal broadcast API is OFF (fails closed). Must MATCH the RENDERER_TOKEN
# set on the renderer service. Generate with:  openssl rand -hex 32
RENDERER_TOKEN=""

# Twitch channel control (optional). Lets the admin Broadcast page set the
# stream's title, category and tags via the Twitch Helix API. Create a Twitch
# application (dev.twitch.tv/console/apps) for CLIENT_ID/SECRET, then generate a
# USER refresh token for the broadcaster account with the
# `channel:manage:broadcast` scope (e.g. via the Twitch CLI:
#   twitch token -u -s "channel:manage:broadcast"). Leave blank to disable.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REFRESH_TOKEN=""

# ── Error alerting (optional — leave ALERT_WEBHOOK_URL blank to disable) ──
# When set, the server POSTs a compact summary to this webhook whenever:
#   * a NEW error fingerprint (kind:message group) appears,
#   * one error group spikes past ALERT_SPIKE_THRESHOLD inside the window,
#   * regression-class save rejections spike past ALERT_SAVE_REJECT_THRESHOLD.
# Payload is Discord-webhook-compatible JSON: { "username", "content" } —
# paste a Discord channel webhook URL here and it just works.
# Blank/unset → alerting is completely off, zero cost. See lib/alerting.ts.
ALERT_WEBHOOK_URL=""

# Rolling window (ms) used for both spike counters. Default 300000 (5 min).
ALERT_WINDOW_MS="300000"

# Events of ONE fingerprint inside the window that trigger a spike alert.
# Default 10 — at ~2,300 players a genuine breakage crosses 10 fast, while
# a one-off flake never does.
ALERT_SPIKE_THRESHOLD="10"

# Regression-class save rejections (validation 400s, milestone-regression
# 409s, versionless-regression 400s — NOT routine stale-save 409s) inside
# the window that trigger an alert. Default 20: normal traffic produces a
# trickle of these from old tabs; a bad deploy produces hundreds.
ALERT_SAVE_REJECT_THRESHOLD="20"

# Minimum gap (ms) between two alerts about the SAME fingerprint.
# Default 900000 (15 min) — one page per problem per quarter-hour.
ALERT_FINGERPRINT_COOLDOWN_MS="900000"

# Global ceiling on webhook POSTs per minute (storm brake). Default 4.
# Suppressed alerts are counted and mentioned in the next one that sends.
ALERT_MAX_PER_MINUTE="4"

# Mute "new fingerprint" alerts for this long after boot (ms). Default
# 120000 (2 min) — right after a deploy restart every fingerprint is "new".
# Spike alerts are NOT muted during the grace period.
ALERT_STARTUP_GRACE_MS="120000"

# Email (Resend) — used for password-reset emails. Two vars and done.
# Leave RESEND_API_KEY blank in dev: emails are logged to the console
# so reset links can be copy-pasted from the server log.
# Get an API key at https://resend.com/api-keys and verify your sender
# domain at https://resend.com/domains.
RESEND_API_KEY=""
EMAIL_FROM="Pokémon Idle <no-reply@pokeidle.com>"

// Pokemon MMO data model. Provider is set via DATABASE_URL — sqlite for
// local dev (file:./dev.db), postgresql in prod (Railway).
//
// To switch providers in prod: change `provider = "postgresql"` here, run
// `npx prisma migrate deploy`. Field types are kept compatible across both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth tables (Better Auth schema) ─────────────────────────────────────
// One row per (user, UTC day) on which the user was actually online.
// This is the table that makes real DAU possible.
//
// `User.lastSeenAt` is a single scalar overwritten on every connect, so
// it can only ever answer "when did they last play" — bucketing it by
// day yields a churn histogram, not activity. That was shipped as the
// hero "Daily Active" chart and was wrong by construction. Activity is
// an event, and events need rows.
//
// Written on socket connect (idempotent per day via the compound
// unique). Deliberately narrow — one row per user per active day is
// ~1 row/day/DAU, trivial to store and cheap to group by.
model DailyActive {
  id     String   @id @default(cuid())
  userId String
  /// UTC midnight of the day this activity happened.
  day    DateTime
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

// One row per (user, milestone) — the new-player funnel. Answers "of
// everyone who signed up, how many picked a starter? Won a first battle?
// Caught a first Pokémon? Reached level 5?" — the question we had NO data
// to answer before this: `accountLevel`/`pokedexCaughtCount` on User are
// point-in-time scalars, overwritten on every save, so there was no way
// to see WHEN (or whether) a player crossed an early milestone, only
// where they happen to sit right now. Same reasoning as DailyActive:
// funnel position is an event, and events need rows.
//
// Idempotent per (user, type) via the compound unique — the client fires
// this the instant a milestone is first crossed and never again; a
// duplicate fire (double-fire from two tabs, a retry) is a harmless
// no-op via the unique constraint, not an error.
model FunnelEvent {
  id        String   @id @default(cuid())
  userId    String
  /// "starter_selected" | "first_wild_win" | "first_catch" |
  /// "first_trainer_win" | "first_gym_badge" | "level_5" | "level_10" |
  /// "level_20" — see server/src/lib/funnel.ts FUNNEL_EVENT_TYPES for the
  /// authoritative list and the funnel order they're charted in.
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([type, createdAt])
}

model User {
  id              String    @id
  email           String    @unique
  emailVerified   Boolean   @default(false)
  name            String?
  username        String    @unique
  displayUsername String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Game state — stored as a JSON blob (serialized GameState minus
  // ephemeral fields). Updated periodically via /api/saves/upload.
  saveData        String?   // JSON-encoded
  saveVersion     Int       @default(0)
  saveUpdatedAt   DateTime  @default(now())
  /// Monotonic counter the SERVER bumps whenever it authoritatively rewrites
  /// this account's save (admin edit / reset / item set / snapshot restore).
  /// The client never writes it. When getSave reports a higher value than the
  /// client last adopted, the client adopts the cloud save WHOLESALE, bypassing
  /// the protective non-destructive merge — so admin reductions/removals stick
  /// (online via the save:adopt socket event, offline via this boot check).
  saveAdoptSeq    Int       @default(0)

  // Profile — derived metrics surfaced to other players.
  accountLevel        Int   @default(0)
  totalCaughtLevels   Int   @default(0)
  pokedexCaughtCount  Int   @default(0)

  // Presence — set by the socket connection lifecycle.
  lastSeenAt      DateTime  @default(now())

  /// When this account last changed its @handle / display name. Null =
  /// never changed, which is the state every OAuth signup starts in
  /// (Google assigned both). Drives the rename cooldowns in
  /// lib/nameChange.ts, and lives here rather than in a process-local
  /// map because an in-memory window would reset on every deploy and
  /// hand an impersonator a fresh switch every time we ship.
  usernameChangedAt DateTime?
  nameChangedAt     DateTime?

  // Daily rewards / login streak. Server-authoritative so the streak can't
  // be farmed by moving the client clock. lastDailyClaimAt is the UTC
  // instant of the last claim; the route compares it against UTC midnight.
  dailyStreak        Int       @default(0)
  longestDailyStreak Int       @default(0)
  lastDailyClaimAt   DateTime?

  /// When this account last collected away-time catch-up progress
  /// (lib/awayProgress.ts). NULL = never claimed.
  ///
  /// THE ATOMIC GATE for that feature, together with `saveUpdatedAt`: away
  /// time is measured from `max(saveUpdatedAt, awayClaimedAt)`, and the claim
  /// route only pays when a conditional UPDATE on the previously-observed
  /// value still matches. Two concurrent claims therefore cannot both succeed
  /// — the same shape as `lastDailyClaimAt` above.
  ///
  /// Server-written only, like every other timestamp here. The client never
  /// sends a time or a duration, so a tampered system clock cannot forge away
  /// progress. The reward itself is paid through the PendingGrant inbox, so
  /// nothing about this column participates in a save write.
  awayClaimedAt      DateTime?

  // Moderation — admin flag bootstraps a user into the admin dashboard;
  // bannedUntil > now blocks login + socket connections.
  isAdmin         Boolean   @default(false)
  bannedUntil     DateTime?
  banReason       String?

  // Relations
  sessions          Session[]
  accounts          Account[]
  friendsRequested  Friend[]      @relation("Requester")
  friendsReceived   Friend[]      @relation("Receiver")
  messages          ChatMessage[]
  dailyActive       DailyActive[]
  giveawayEntries   GiveawayEntry[]
  saveSnapshots     SaveSnapshot[]
  pendingGrants     PendingGrant[]
  funnelEvents      FunnelEvent[]
  auctionsSelling   Auction[]     @relation("AuctionSeller")
  bids              Bid[]         @relation("Bidder")
  proxyBids         AuctionProxyBid[] @relation("ProxyBidder")
  pollVotes         PollVote[]
  streamKey         StreamKey?
  /// PvP ladder rewards (lib/pvpLadder.ts). Relation fields only — they
  /// generate no DDL, so the hand-written migration
  /// 20260730120000_add_pvp_ladder stays the complete description of the
  /// tables. Two lists for PvpLadderEarn because it carries TWO foreign keys
  /// to User, and that second one ("opponentUserId") is the constraint that
  /// makes a synthetic AI/bot opponent unable to be paid.
  pvpLadderEarns     PvpLadderEarn[]     @relation("PvpLadderEarner")
  pvpLadderAgainst   PvpLadderEarn[]     @relation("PvpLadderOpponent")
  pvpWinBonusClaim   PvpWinBonusClaim?
  pvpBadgeMilestones PvpBadgeMilestone[]
  pvpLadderBaseline  PvpLadderBaseline?
  /// Discord account binding for the community bot. Optional — the
  /// overwhelming majority of accounts will never have one. A relation
  /// field only; it generates no DDL, so the hand-written migration
  /// 20260731120000_add_discord_link remains the complete description
  /// of the table.
  discordLink        DiscordLink?
  /// Where this account came from. Absent for every account created before
  /// collection began, and for anyone whose browser blocked the write —
  /// which is why the dashboard reports coverage rather than assuming the
  /// rows it has are the whole picture.
  signupAttribution  SignupAttribution?
}

/// How one account arrived: the referring site, the campaign tags on the
/// landing URL, and the channel those classify to.
///
/// ── WHY A SEPARATE TABLE ────────────────────────────────────────────
/// User is loaded on every save, every socket connect and every leaderboard
/// query, and already carries a multi-megabyte saveData column. Attribution
/// is read by exactly one page in the admin dashboard. Bolting eight more
/// columns onto the hottest row in the database to serve the coldest reader
/// would be the wrong trade.
///
/// It also makes "we have no attribution for this account" a missing row
/// rather than eight nulls, so coverage is a join away instead of a
/// convention everyone has to remember.
///
/// ── WHY THE VALUES ARE PRE-NORMALISED ───────────────────────────────
/// channel/source are written already lowercased, de-www'd and classified by
/// server/src/lib/acquisition.ts. The read side does nothing but GROUP BY, so
/// there is no second implementation to drift.
model SignupAttribution {
  /// The account, and the primary key: one attribution per account, first
  /// write wins. Not a surrogate id — there is no such thing as a second
  /// acquisition for the same signup.
  userId       String   @id
  createdAt    DateTime @default(now())

  /// direct | organic | social | referral | paid | email
  channel      String
  /// The grouping key: utm_source when the link was tagged, else the
  /// referring host, else "direct". Never null.
  source       String
  medium       String?
  campaign     String?
  term         String?
  content      String?
  /// Host only — never the full referring URL. See acquisition.ts.
  referrerHost String?
  /// Path only, query stripped.
  landingPath  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The dashboard windows by date and groups by channel/source; both are
  /// scans over a table with one row per signup, so the indexes matter at
  /// the scale this reaches rather than the scale it is at.
  @@index([createdAt])
  @@index([channel])
  @@index([source])
}

/// Per-account constant secret that lets an OBS/24-7 stream auto-login via
/// a stable link (pokeidle.com/stream-login?key=…). Only accounts an admin
/// explicitly enables have one. The resulting session is RESTRICTED — it can
/// play and save but is blocked from account settings, trades and auctions —
/// so a leaked link can't be used to drain or hijack the account. Revoke by
/// setting enabled=false (or regenerate to rotate the secret).
model StreamKey {
  id         String    @id @default(cuid())
  userId     String    @unique
  key        String    @unique
  enabled    Boolean   @default(true)
  label      String?
  /// JSON stream automation config the admin sets for an unattended run:
  /// { startRoute?: string, autoBuyBalls?: { enabled, ballId, restockTo } }.
  /// Applied client-side when a stream session boots (see streamMode.ts).
  config     String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  lastUsedIp String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
}

/// Singleton control row for the 24/7 Twitch renderer service. The admin
/// dashboard writes the DESIRED broadcast state (on/off, which account, and
/// encode quality); the external renderer polls it over a token-authed
/// internal endpoint, drives a headless Chromium + ffmpeg → Twitch RTMP, and
/// writes its LIVE status back here. Exactly one row, id = "singleton".
model BroadcastState {
  id            String    @id @default("singleton")
  enabled       Boolean   @default(false)
  /// The User whose stream-login the renderer opens. Must have an enabled
  /// StreamKey. Stored as a plain id (no FK) so deleting the row is trivial.
  accountUserId String?
  width         Int       @default(1920)
  height        Int       @default(1080)
  fps           Int       @default(30)
  bitrateKbps   Int       @default(6000)
  updatedAt     DateTime  @updatedAt
  /// Reported by the renderer on each poll:
  live          Boolean   @default(false)
  lastStatus    String?
  lastStatusAt  DateTime?
  createdAt     DateTime  @default(now())
}

/// Append-only checkpoints of a player's save, so a bad or clobbered write
/// is recoverable. The server keeps NO other history — saveData is a single
/// column overwritten in place — so before this, any accepted-but-wrong
/// write was unrecoverable. Not every write is snapshotted (that would be
/// thousands of near-identical rows per hour): one is taken at most every
/// SNAPSHOT_INTERVAL_MS per player, and the ring is pruned to the newest
/// MAX_SNAPSHOTS_PER_USER.
model SaveSnapshot {
  id          String   @id @default(cuid())
  userId      String
  saveVersion Int
  saveData    String
  /// Why it exists: "auto" (periodic) | "pre-restore" (captured just before
  /// an admin restore, so the restore is itself reversible).
  reason      String   @default("auto")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A DURABLE INBOX of prizes the server owes a player.
///
/// Why this table exists (real incident): a giveaway draw used to write the
/// prize straight into User.saveData. That write raced the winner's own
/// autosave — the client holds the save in memory and re-pushes the whole
/// blob every ~2.5s — so for anyone who happened to be PLAYING when the draw
/// fired, the next push overwrote the freshly-granted item and it was gone
/// forever. The draw reported success (GiveawayEntry.claimedAt was set), the
/// player never got the item, and because the client persists the resulting
/// saveVersion there was no later reconcile that could bring it back.
/// Offline winners were fine — which is why it looked random.
///
/// The fix is to stop racing the save blob at all. A grant now writes ONE row
/// here and nothing else. The prize is folded into the player's save by the
/// save endpoint itself (server/src/routes/saves.ts), on top of whatever blob
/// the client just uploaded, inside the same transaction that accepts the
/// upload. A stale client push therefore cannot erase a grant: the grant is
/// applied AFTER the client's bytes, every time, until it is delivered.
///
/// A SECOND session of the same account could still erase it — it 409s, keeps
/// its stale blob, learns the new saveVersion and pushes past the CAS — so the
/// fold also bumps User.saveAdoptSeq in the same UPDATE. A client can only
/// learn the new saveVersion from a response that carries the new adopt seq
/// with it, and that seq means "adopt the cloud copy wholesale". The stale
/// bytes are never pushed.
///
/// `deliveredAt` is the durable idempotency marker. It is set by a
/// compare-and-swap (`WHERE deliveredAt IS NULL`) in that same transaction,
/// so replaying delivery — a retry, two devices uploading at once, a server
/// restart mid-write — can never double-grant: whoever loses the CAS rolls
/// the whole save write back and retries.
model PendingGrant {
  id        String   @id @default(cuid())
  userId    String
  /// JSON array of Prize (see lib/giveaway.ts) — the exact same descriptors
  /// the giveaway/mass-gift UI produced. Stored verbatim so a grant can be
  /// re-read, audited, or hand-inspected long after the fact.
  prizes    String
  /// Where it came from: "giveaway" | "mass-gift" | "backfill" | …
  /// Free-form on purpose; it is an audit label, never a control-flow key.
  source    String
  /// The giveaway id / auction id / whatever the source keys on. Nullable
  /// because not every source has one.
  sourceId  String?
  /// describePrizes() output, denormalised so ops can read the queue without
  /// parsing JSON, and so the client can toast a human summary.
  summary   String
  createdAt DateTime @default(now())

  /// NULL = still owed. Non-null = paid, once and for all.
  ///
  /// THIS IS THE DELIVERY GATE, and it is the only one. It is set by a
  /// compare-and-swap (`WHERE deliveredAt IS NULL`) inside the same
  /// transaction that stores the folded save, so a rolled-back save pays
  /// nothing and two concurrent uploads cannot both pay.
  ///
  /// Nothing the client sends participates. The obvious alternative — a
  /// receipt inside the save blob, so a save that LOST the prize could be
  /// paid again — was built and removed: it makes the gate a field the client
  /// supplies, and stripping it in localStorage re-paid every recent grant on
  /// every upload. There is no safe version of that, because the server
  /// cannot distinguish "never received it" from "received it and spent it".
  ///
  /// So the prize is not healed after the fact; the overwrite that would lose
  /// it is PREVENTED. The fold bumps User.saveAdoptSeq in the same UPDATE, so
  /// every session of that account adopts the cloud copy — the one holding the
  /// prize — instead of racing it with a stale blob. See lib/saveAdopt.ts.
  deliveredAt          DateTime?
  /// The saveVersion the fold produced. Forensics only.
  deliveredSaveVersion Int?

  /// Bumped when a fold was attempted and REFUSED (e.g. the combined save
  /// would fail validateSave because the box is full). The grant stays owed;
  /// this is how ops find one that is stuck rather than merely unclaimed.
  attempts  Int     @default(0)
  lastError String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The hot path: "what does this user still owe?" on every save upload.
  @@index([userId, deliveredAt])
  /// Ops sweep: "what is owed across all accounts, oldest first?"
  @@index([deliveredAt, createdAt])
  /// "Did this giveaway's prizes actually land?" — GET /admin/giveaways joins
  /// on it so a winner can be shown as OWED instead of mislabelled UNPAID.
  /// The table is append-only and a mass gift adds a row per account, so this
  /// lookup must not be a sequential scan.
  @@index([source, sourceId])
}

/// Binds a Discord account to a game account, for the community bot.
///
/// ── WHY THIS IS A TABLE AND NOT A COLUMN ON User ────────────────────
/// Discord identity is not part of who an account IS. It is one optional
/// integration that a small minority of accounts will ever use, it can be
/// severed at any time from either side, and it must never end up in the
/// select list of a route that is merely reading a profile. A separate
/// table makes leaking it require an explicit join, which is the property
/// worth having: everything the bot reads is assumed to end up screenshotted
/// in a public Discord channel, and the mapping from game account to Discord
/// account is the one piece of that graph a player has not consented to
/// publish.
///
/// ── WHY BOTH SIDES ARE UNIQUE ───────────────────────────────────────
/// `discordId` is the primary key and `userId` is UNIQUE, so the binding is
/// strictly one-to-one in both directions. This is enforced by the database
/// rather than by the link route, because both of the failure modes it
/// prevents are ones an application-level check loses to a race:
///
///   * One Discord account claiming several game accounts turns every
///     per-account limit the bot enforces (a giveaway entry, a trade
///     listing, a role) into a per-account-times-N limit.
///   * One game account claimed by several Discord accounts means a prize
///     drawn for "that player" has no single Discord recipient, and role
///     sync has no single member to reconcile.
///
/// Rebinding is therefore delete-then-create — `/unlink` then `/link` — and
/// never an update, so there is no code path that silently moves a binding
/// out from under someone.
///
/// ── WHY THE BOT CANNOT MOVE ANYTHING ────────────────────────────────
/// This row is a lookup key and nothing else. It confers no capability: the
/// bot's API surface is read-only apart from prize grants (which go through
/// PendingGrant, never a save write) and trade LISTINGS (which are text, not
/// custody). A phished Discord account therefore reaches a trainer card and
/// a noticeboard post, and cannot reach a Pokémon. See the live trade flow
/// in server/src/socket.ts for why asset movement stays there and only there.
/// Operator-editable Discord settings. A singleton control row, exactly like
/// BroadcastState — same `@default("singleton")` id, same reason: there is one
/// of it, and a table with one row is simpler than a key-value store nobody
/// can typecheck.
///
/// ── WHY THIS IS NOT ENVIRONMENT VARIABLES ───────────────────────────
/// It was, briefly. Env is the wrong home for anything an operator changes as
/// a JUDGEMENT CALL rather than as configuration: changing the link reward
/// meant editing Railway's env and waiting for a redeploy, which is a lot of
/// ceremony for "let's try a Rare Candy instead this week", and it means the
/// value lives somewhere the admin dashboard cannot show. Deployment config
/// (tokens, URLs) stays in env; promotion content lives here.
model DiscordConfig {
  id String @id @default("singleton")

  /// JSON array of Prize (see lib/giveaway.ts) — paid ONCE the first time an
  /// account links its Discord. Null or an empty array means no reward is
  /// configured.
  ///
  /// Stored as JSON text rather than a relation for the same reason
  /// Giveaway.prizes is: prizes are small, never queried independently, and
  /// their shape follows the game's catalog rather than the database's.
  linkReward String?

  /// Master switch, separate from `linkReward` being set, so a promotion can
  /// be PAUSED without losing its configuration. Clearing the prize to turn it
  /// off and re-entering it to turn it back on is how an operator ends up
  /// giving away the wrong thing.
  linkRewardEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  /// The admin who last saved. Display only — AdminAudit is the real ledger.
  updatedBy String?

  /// ── Role thresholds ─────────────────────────────────────────────
  /// Account level for the Ace Trainer role, and rated matches before anyone
  /// is awarded Champion. NULL = fall back to the env default.
  ///
  /// These started as environment variables and moved here for the same
  /// reason the reward did: they are numbers an operator TUNES by looking at
  /// the player base, not deployment configuration. The right Ace Trainer bar
  /// is unknowable in advance — it depends on a level curve that shifts as the
  /// game grows — so it has to be adjustable without a redeploy, from a page
  /// that can show what the current value actually catches.
  aceTrainerMinLevel Int?
  championMinMatches Int?

  /// ── Community XP ────────────────────────────────────────────────
  /// Off until an operator turns it on. NULL on the numbers means "use the
  /// built-in default", same per-field fallback as the role thresholds.
  xpEnabled       Boolean @default(false)
  xpPerMessageMin Int?
  xpPerMessageMax Int?
  /// Seconds between paid messages for one user. The anti-spam gate: without
  /// it, XP measures typing speed rather than participation.
  xpCooldownSec   Int?
  /// Comma-separated channel ids that earn nothing — bot-command channels,
  /// counting channels, anywhere volume is the point rather than conversation.
  xpIgnoredChannels String?
  /// Where level-ups are announced. NULL = announce in the channel they were
  /// earned in, which is the least surprising default.
  xpAnnounceChannelId String?

  /// ── Bot liveness ────────────────────────────────────────────────
  /// When the bot last checked in. The dashboard turns this into
  /// "connected" / "last seen 4 minutes ago" / "offline".
  ///
  /// Written by the bot, on its own reconcile tick, through the bot API. The
  /// game server has no way to ASK whether the bot is alive — it holds no
  /// Discord token and does not know where the bot runs — so liveness has to
  /// be reported rather than probed. That is the same direction the renderer
  /// reports its status in (BroadcastState.lastStatusAt), for the same reason.
  ///
  /// Stale is the honest default: if the bot dies, this simply stops moving,
  /// and "last seen 2 hours ago" is exactly the right thing to show.
  botLastSeenAt DateTime?
  /// JSON blob of whatever the bot reported: guild member count, roles
  /// granted/removed on the last pass, its own version. Free-form because it
  /// is DISPLAY ONLY — nothing branches on it, so the bot can add a field
  /// without a migration and an older dashboard just ignores it.
  botStatus String?
}

/// Community XP: levels earned by talking and taking part in the Discord.
///
/// ── WHY THIS KEYS ON discordId AND NOT userId ───────────────────────
/// It is deliberately NOT tied to a game account. Someone who has never
/// played can join, chat, and level up — which is the point, because the
/// server should be worth being in before you have linked anything. A
/// userId key would mean the very people you are trying to convert earn
/// nothing.
///
/// It also means there is no foreign key to User and no cascade. A Discord
/// account that leaves keeps its row; if they come back, their level is
/// still there. The row is small and the population is Discord-sized.
///
/// ── WHY THIS IS A SEPARATE CURRENCY FROM THE GAME ───────────────────
/// XP here buys Discord standing and nothing else. It does not convert into
/// money, items, account level, or anything the game economy can see.
///
/// That is a product decision and it is load-bearing: the alternative — chat
/// XP paying out in-game currency — puts a faucet on the economy whose tap is
/// "type in a text box", and no cooldown makes that safe against someone who
/// wants it badly enough. Keeping the currencies separate means the worst case
/// for an XP exploit is a wrong number on a leaderboard, not inflation.
///
/// If that ever changes, it must go through PendingGrant like every other
/// payout, and this comment should be the thing that gets argued with.
model DiscordXp {
  /// Discord snowflake. No FK — see above.
  discordId String @id
  /// Lifetime XP. Level is DERIVED from this and never stored; see
  /// lib/discordXp.ts. One number is one source of truth, and a stored level
  /// is a second one that can disagree after any curve change.
  xp        Int    @default(0)
  /// Messages that actually earned XP — i.e. after the cooldown. Not a message
  /// count: it is the number of times we paid, which is what makes the
  /// cooldown's effect visible in the admin stats.
  messages  Int    @default(0)
  /// Last time this user was PAID for a message. The cooldown gate, held
  /// server-side so a bot restart cannot reset it.
  lastAwardAt DateTime?
  /// Display label, refreshed on each award. Denormalised so the leaderboard
  /// can render without the bot resolving every id against Discord — which
  /// would be a per-row API call on a command that shows ten of them.
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The leaderboard: highest first.
  @@index([xp])
}

model DiscordLink {
  /// Discord snowflake. The primary key, so one Discord account maps to at
  /// most one game account by construction. Stored as text: snowflakes are
  /// 64-bit and JavaScript numbers are not.
  discordId String   @id
  userId    String   @unique
  linkedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String    // OAuth subject id, or email for credentials
  providerId            String    // "credential" | "google"
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // hashed (credentials provider)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ── Social ───────────────────────────────────────────────────────────────
model Friend {
  id          String   @id @default(cuid())
  requesterId String
  receiverId  String
  status      String   // "pending" | "accepted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("Receiver",  fields: [receiverId],  references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

// ── Map editor ───────────────────────────────────────────────────────────
// Single row per location id, edited via the admin dashboard. The game
// frontend pulls these on boot and uses them to override the hard-coded
// positions in `data/regions/<id>/routes.ts`. Pre-populated from the
// existing values in routes.ts on first run.
model MapPosition {
  locationId String   @id
  x          Float
  y          Float
  updatedAt  DateTime @updatedAt
  updatedBy  String?  // admin user id
}

// Crop rectangle for the town map image. All four values are
// percentages of the source image (0..100). Lets the admin trim away
// decorative borders/sky so only the playable region shows in the
// game. Single row per regionId; the game pulls it on boot and uses
// it to scale + offset the background image.
model MapCrop {
  regionId  String   @id
  x         Float    // top-left X in source-image %
  y         Float    // top-left Y in source-image %
  w         Float    // width  in source-image %
  h         Float    // height in source-image %
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ── Bug reports ──────────────────────────────────────────────────────────
// User-submitted bug reports from the in-game "Report a bug" button.
// Stored alongside who reported, what page they were on, the user
// agent string, and an optional structured game-state snapshot the
// admin can use to reproduce.
model BugReport {
  id           String   @id @default(cuid())
  reporterId   String?  // nullable so a deleted user's reports survive for triage
  reporterName String   // denormalized so admin doesn't need a join just to see who reported
  title        String
  description  String
  page         String?  // window.location.href at submission
  userAgent    String?
  // JSON-encoded condensed game state snapshot (party species/levels,
  // currentLocation, last few battle-log lines). Optional — heavy
  // saves aren't worth shipping over the wire.
  context      String?
  status       String   @default("open") // "open" | "investigating" | "resolved" | "wontfix"
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Where this report came from: "game" (the in-game Report Bug modal) or
  /// "discord" (a post in the community server's bug channel, ingested by the
  /// bot). Free-form like PendingGrant.source — an audit label, never a
  /// control-flow key — so a third source later needs no migration.
  source String @default("game")

  /// The Discord message this was ingested from, when source is "discord".
  ///
  /// UNIQUE, and that is the whole idempotency story. The bot both listens
  /// live AND sweeps recent history on boot (to pick up anything posted while
  /// it was down), so the same message reliably arrives more than once. A
  /// unique constraint means the duplicate is refused by the database rather
  /// than by a check that a race can lose — the same shape as
  /// GiveawayEntry's one-entry-per-user rule.
  ///
  /// Nullable because in-game reports have no Discord message, and Postgres
  /// unique indexes permit many NULLs — so this constrains exactly the rows it
  /// should and ignores the rest.
  discordMessageId String? @unique

  @@index([status, createdAt])
  @@index([reporterId])
}

// ── Error log ────────────────────────────────────────────────────────────
// Append-only stream of unhandled errors. Two sources:
//   - kind="server"  Hono onError caught a thrown error in a route
//   - kind="client"  Browser ErrorBoundary / window.onerror reported one
// Useful for admin triage when something blows up in production.
model ErrorLog {
  id         String   @id @default(cuid())
  kind       String   // "server" | "client"
  level      String   @default("error") // "error" | "warn"
  message    String
  stack      String?
  // Where it happened — server route path or client URL
  source     String?
  // Caller identity if known (server: from middleware; client: from cookie session)
  userId     String?
  username   String?
  // Useful auxiliary context
  userAgent  String?
  // JSON-encoded extra data (request body excerpt, component stack, etc.)
  meta       String?
  createdAt  DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId, createdAt])
}

// ── Admin audit log ──────────────────────────────────────────────────────
// Append-only record of every action an admin takes that touches another
// user (raw save read, ban, demote, hard-delete, reset-save, chat-mod
// delete). Lets us trace who did what when, and gives admins a record
// they can show if a user disputes an action.
model AdminAudit {
  id        String   @id @default(cuid())
  adminId   String   // who took the action
  action    String   // e.g. "user.read_save", "user.ban", "user.delete"
  targetId  String?  // affected user / message id when relevant
  meta      String?  // optional JSON-encoded extras
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetId, createdAt])
}

// ── Chat ─────────────────────────────────────────────────────────────────
// channelId convention:
//   "global"               — global chat
//   "dm:<userIdA>:<userIdB>" — DMs (sorted user ids so both sides resolve same key)
model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String
  // "user" (default, ordinary chat) | "announcement" | "giveaway" |
  // "tradeOffer" — lets the client render system/giveaway broadcasts
  // and trade-offer cards distinctly instead of as a normal bubble
  // from whichever account posted them. userId is still the acting
  // admin (or trading player) for audit/moderation, even on non-"user"
  // rows.
  kind      String   @default("user")
  // JSON-encoded, kind-specific (e.g. tradeOffer: {offering, wanting}).
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// ── PvP battles ──────────────────────────────────────────────────────────
// One row per completed PvP battle. The live battle runs in-memory on
// the server with @pkmn/sim; this model captures the result + a replay
// log so the admin dashboard (and eventually a "match history" surface
// for players) has something to show. Teams are snapshotted as JSON
// at battle-start time so a later party change doesn't rewrite history.
model PvpMatch {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  format      String   // "anything-goes" for v1; tier id later
  status      String   // "active" | "completed" | "forfeit" | "cancelled"

  userAId           String
  userAUsername     String
  userATeam         String   // JSON-serialized PokemonSet[] sent to @pkmn/sim
  userBId           String
  userBUsername     String
  userBTeam         String

  winnerId          String?  // null on cancellation / mutual draw
  loserId           String?
  endReason         String?  // "ko" | "forfeit" | "timeout" | "cancelled"
  battleLog         String?  // newline-joined Showdown protocol lines
  tournamentId      String?  // set when this match is part of a tournament round

  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
  @@index([tournamentId])
}

// ── Tournaments ──────────────────────────────────────────────────────────
// Foundation only in v1 — schema + admin endpoints to create/seed/run
// brackets are scaffolded but the player-facing UI ships in a follow-up.
// `bracket` holds a JSON tree of round/match assignments updated as
// matches complete; advancement reads the winner from PvpMatch and
// rewrites the next round's slots.
// ── Giveaways / draws ───────────────────────────────────────────────
//
// An operator-run prize draw. Players enter (free, one entry each),
// the operator draws N winners, and prizes are granted automatically
// to the winners' saves.
//
// Fairness is the whole product here — a draw players do not trust is
// worse than no draw at all. So:
//   * `drawSeed` is recorded at draw time and the winner selection is
//     a deterministic function of (seed, sorted entry ids). Anyone can
//     be shown the seed afterwards and the result recomputed.
//   * Entries are immutable once the draw happens (drawnAt set).
//   * Every draw is written to the admin audit log.
model Giveaway {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// When entries open. Null = open immediately on publish.
  startsAt    DateTime?
  /// When entries close. Null = open until the operator draws.
  endsAt      DateTime?
  drawnAt     DateTime?

  title       String
  description String
  /// "draft" | "open" | "closed" | "drawn" | "cancelled"
  status      String   @default("draft")

  /// How many winners to pick.
  winnerCount Int      @default(1)

  /// JSON array of prize descriptors, e.g.
  /// [{"kind":"item","itemId":"masterball","quantity":1},
  /// {"kind":"money","amount":50000},
  /// {"kind":"pokemon","speciesKey":"mew","level":50,"isShiny":true}]
  /// Kept as JSON rather than a table: prizes are small, never queried
  /// independently, and the shape evolves with the game's catalog.
  prizes      String

  /// Optional entry gates. Null = anyone may enter.
  minAccountLevel Int?
  /// Recorded at draw time so the result can be re-derived and shown
  /// to be fair. Null until drawn.
  drawSeed    String?

  ownerId     String

  /// ── Discord announcement (the community bot, bot/) ──────────────
  /// Operator intent, set from the admin dashboard: "post this one in
  /// Discord". Nothing reads it except the bot's sync poll.
  ///
  /// The game server does NOT talk to Discord — it holds no token and knows
  /// no channel semantics (see lib/discordRoles.ts for why). So this is a
  /// FLAG the bot polls for, not a job the server runs. A Discord outage is
  /// therefore invisible here: there is no request to fail and no retry queue
  /// to grow.
  announceToDiscord Boolean @default(false)
  /// Channel to post in. Null = the bot's configured default. Stored rather
  /// than resolved so an operator can send one giveaway somewhere unusual.
  discordChannelId  String?
  /// Set once the bot has posted the entry embed.
  ///
  /// THIS IS THE ANNOUNCE IDEMPOTENCY MARKER. The bot polls on a timer, so
  /// without it every tick would post the same giveaway again. The bot writes
  /// it back immediately after posting, and the poll filters on
  /// `discordMessageId IS NULL` — the same shape as `deliveredAt` gating a
  /// grant, for the same reason.
  discordMessageId  String?
  /// Set once the bot has posted the RESULT. Separate from the announce
  /// marker because they are two different posts at two different times, and a
  /// giveaway drawn from the admin dashboard has an announcement but no result
  /// post until the next poll.
  discordResultsAt  DateTime?

  entries GiveawayEntry[]

  @@index([status, createdAt])
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  userId     String
  username   String   // denormalised so a deleted account still shows in results
  createdAt  DateTime @default(now())
  isWinner   Boolean  @default(false)
  /// Set once the prize has been durably OWED to the winner — i.e. the
  /// PendingGrant row is committed — so a retry cannot double-grant.
  ///
  /// It no longer means "the item is in their saveData this instant", and it
  /// deliberately does not: writing the save directly at draw time is what
  /// raced the winner's own autosave and destroyed prizes (see
  /// lib/prizeGrant.ts). Delivery now happens on the winner's next save
  /// upload. A non-null claimedAt is still the operator's "do not re-grant"
  /// signal — the prize cannot be lost from here. To see whether it has
  /// physically landed, read PendingGrant.deliveredAt
  /// (GET /admin/pending-grants).
  claimedAt  DateTime?

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One entry per user per giveaway — this is what makes it a fair
  // draw rather than a spam contest.
  @@unique([giveawayId, userId])
  @@index([giveawayId, isWinner])
}

/// An admin-created poll posted to Global chat for players to vote on.
/// Unlike Giveaway (one-time entry, drawn once), a poll is live opinion
/// data — a vote can change any time before the poll closes, and results
/// are public and update in real time as an intentional "watch the bars
/// move" feature, not something withheld until a reveal.
model Poll {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  closedAt  DateTime?
  question  String
  /// JSON array of option label strings, e.g. ["Yes","No","Undecided"]
  options   String
  /// "draft" | "open" | "closed"
  status    String     @default("draft")
  ownerId   String

  votes PollVote[]

  @@index([status, createdAt])
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  username    String   // denormalised so a deleted account still shows in admin results
  optionIndex Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A vote can be changed (upsert on this key) but a user has only one
  // live choice per poll at a time.
  @@unique([pollId, userId])
  @@index([pollId, optionIndex])
}

/// A pinned, server-wide banner shown in the top of every player's chat
/// column. Distinct from a chat announcement (which scrolls away like any
/// message): this persists until an admin clears or replaces it, and a
/// player who joins hours later still sees it. Exactly one is "current" at
/// a time — publishing a new one deactivates the rest.
model Announcement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Visual + semantic category. One of:
  /// "info" | "event" | "giveaway" | "warning" | "maintenance".
  /// Drives the banner's icon and colour on the client.
  type      String   @default("info")

  /// The banner text. Kept short — this is a single glanceable line.
  message   String

  /// Optional call-to-action. `href` may be an external URL or an in-app
  /// hash route (e.g. "#giveaways"); `linkLabel` is the button text.
  href      String?
  linkLabel String?

  /// Whether this banner is live. Only one row is active at a time;
  /// publishing a new banner flips every other row to false.
  active    Boolean  @default(true)

  /// Optional schedule. `startsAt` in the future hides it until then;
  /// `expiresAt` in the past hides it again. Null = no bound.
  startsAt  DateTime?
  expiresAt DateTime?

  /// The admin who published it (User.id). Not a relation — an admin
  /// account being deleted must never cascade-delete history.
  createdBy String

  @@index([active, createdAt])
}

model Tournament {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  startsAt    DateTime?
  finishedAt  DateTime?
  name        String
  format      String   // mirrors PvpMatch.format
  // Optional level cap applied to every PokemonSet at battle-start
  // time. Lets organisers run "Lv 50 only" or "Lv 100 cap" brackets
  // without participants having to re-train mons. The original save
  // is untouched — only the in-battle PokemonSet sees the cap.
  levelCap    Int?
  status      String   // "scheduled" | "open" | "live" | "completed" | "cancelled"
  bracket     String?  // JSON tree of rounds → match slots
  ownerId     String   // admin who created it

  /// How long each ROUND stays open, in minutes. This is the single knob
  /// that makes a bracket survive this game's actual population: ~34
  /// accounts online in a given hour, ~74 across a day. A synchronous
  /// 16-player draw needs 16 people in the same 20 minutes and will never
  /// happen. With a window measured in hours the round is asynchronous —
  /// the runner starts each pairing the moment BOTH players happen to be
  /// online at the same time, and awards a walkover at the deadline to
  /// whoever did show. Default 1440 = a 24h round.
  roundWindowMinutes Int @default(1440)

  /// When true, lib/tournamentRunner.ts drives this event: auto-starting
  /// pairings, applying results, enforcing round deadlines and declaring
  /// the champion. False leaves it entirely to the admin buttons (the old
  /// v1 behaviour) — useful for a hand-run showmatch.
  autoRun Boolean @default(true)

  /// Champion, denormalised at completion. `championId` is a User.id;
  /// `championUsername` is captured alongside so a later rename or a
  /// deleted account still renders a readable winner in history.
  championId       String?
  championUsername String?

  /// Optional JSON array of Prize (see lib/giveaway.ts) awarded to the
  /// champion when the final resolves. Delivered through the same durable
  /// PendingGrant inbox giveaways use, never by writing saveData.
  /// `prizeGrantedAt` is the idempotency marker — a second completion
  /// sweep must never pay twice.
  prizes         String?
  prizeGrantedAt DateTime?

  /// ── Discord announcement (the community bot, bot/) ──────────────
  /// Same four-column shape as Giveaway, and for the same reasons — read
  /// migrations/20260801120000_giveaway_discord_announce for the full
  /// argument. The short version: the game server holds no Discord token, so
  /// the bot POLLS these; `discordMessageId IS NULL` is the idempotency
  /// marker, and the bot posts first and marks second.
  ///
  /// Defaults to false rather than true even though a tournament is always a
  /// community event. Every tournament that exists today predates the bot, and
  /// a default of true would have the first poll announce a bracket that has
  /// already been won.
  announceToDiscord Boolean @default(false)
  /// Overrides the bot's default ladder channel. Null = bot's choice.
  discordChannelId  String?
  /// Set once the OPEN announcement is posted. Also the poll's filter.
  discordMessageId  String?
  /// Set once the CHAMPION post is made. Separate marker because they are two
  /// posts at two different times — often days apart, given a round window is
  /// 24h by default.
  discordResultsAt  DateTime?

  entries TournamentEntry[]

  @@index([status, createdAt])
}

model TournamentEntry {
  id            String   @id @default(cuid())
  tournamentId  String
  userId        String
  username      String   // captured at signup so renames don't break the bracket
  seed          Int?     // seeding number, lower = better. Assigned from ELO at generate-bracket time.
  /// PlayerRating.rating snapshotted when the seed was assigned. Kept so
  /// the bracket can be explained after the fact ("why was I seed 9?")
  /// without re-reading a rating that has since moved.
  ratingAtSeed  Int?
  eliminated    Boolean  @default(false)
  joinedAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, eliminated])
  @@index([userId])
}

// ── PvP rating (ELO) ─────────────────────────────────────────────────────
// Per-user competitive rating. Only random50 matches (matchmaking
// queue) update this — friend invites are casual / unrated, and
// tournaments have their own bracket-driven progression. K-factor is
// 32 (standard chess); starting rating is 1000. peakRating tracks
// the all-time high so the trainer card can show a "best ever".
//
// Stats columns are denormalised for cheap leaderboard reads — we
// could derive them from PvpMatch but this avoids a count-aggregate
// every time the trainer card opens.
model PlayerRating {
  userId         String   @id
  rating         Int      @default(1000)
  peakRating     Int      @default(1000)
  matchesPlayed  Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  forfeits       Int      @default(0)
  lastMatchAt    DateTime?
  updatedAt      DateTime @updatedAt

  @@index([rating])
}

// ── Trade history ────────────────────────────────────────────────────────
// Append-only record of every completed trade. The live trade flow lives
// entirely in memory (server/src/socket.ts) so a successful swap normally
// leaves no on-disk trace; this table catches each completion as it
// happens so the admin dashboard (and, eventually, players themselves)
// can review past trades.
//
// Both sides are denormalized — userId + the JSON snapshot of the mon
// they sent — so a deleted user account leaves the trade record intact
// for the surviving counterpart. usernameSnapshot likewise is captured
// at trade time so a later username change doesn't rewrite history.
model TradeRecord {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  userAId           String
  userAUsername     String
  userASentMon      String   // JSON-serialized Pokémon snapshot
  userASentSpecies  String
  userASentLevel    Int

  userBId           String
  userBUsername     String
  userBSentMon      String
  userBSentSpecies  String
  userBSentLevel    Int

  @@index([userAId, createdAt])
  @@index([userBId, createdAt])
}

// ── Auctions ─────────────────────────────────────────────────────────────
// A seller lists ONE specific Pokemon (by its stable per-mon id) from
// their party/box; other players bid in-game money (the same currency
// spent in RewardShopPanel), highest bid when endsAt passes wins.
//
// Deliberately no upfront escrow: bidding is a soft-checked commitment
// (bid amount validated against the bidder's money at bid time), and
// the actual money+Pokemon transfer only happens at settlement, which
// re-validates both sides against LIVE saveData and atomically mutates
// both players' saves with the same optimistic-concurrency (saveVersion
// compare-and-swap) pattern saves.ts uses for the player upload path.
// If either side no longer checks out at settlement (mon traded/released/
// evolved away, or the winning bidder's money dropped below their bid),
// the auction is cancelled rather than partially applied — no fallback
// to the next-highest bid, keeping settlement a single all-or-nothing step.
model Auction {
  id              String    @id @default(cuid())
  sellerId        String
  pokemonId       String    // stable per-mon id from the seller's save at listing time
  pokemonSnapshot String    // JSON Pokemon snapshot at listing time — display only, re-validated live at settlement
  startingBid     Int
  currentBid      Int       @default(0)
  currentBidderId String?
  status          String    @default("active") // "active" | "sold" | "cancelled" | "expired"
  endsAt          DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  settledAt       DateTime?

  seller User  @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  bids   Bid[]
  // The CURRENT LEADER's secret maximum, if any. A relation field only —
  // it adds no column to this table, which is the point (see AuctionProxyBid).
  proxyBid AuctionProxyBid?

  @@index([status, endsAt])
  @@index([sellerId, createdAt])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Int
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation("Bidder", fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([bidderId, createdAt])
}

// PROXY (MAXIMUM) BIDS. A bidder submits the most they are willing to pay;
// the server raises on their behalf by the minimum increment only as far as
// it must, so the lot goes to whoever valued it highest rather than whoever
// clicked last. DDL: the hand-written migration
// 20260730150000_add_auction_proxy_bid/migration.sql, which carries the full
// reasoning — this model mirrors it and adds nothing of its own.
//
// ONE ROW PER AUCTION, holding only the CURRENT LEADER's maximum: a beaten
// maximum is consumed the instant it loses, which is what keeps proxy
// resolution closed-form (see resolveProxy in lib/auctionBidRules.ts — one
// comparison, zero iterations, no loop to terminate).
//
// `maxAmount` IS SECRET. It is deliberately NOT reachable from any query
// against Auction, so no route that serialises an auction for another player
// can leak it by accident — the one place it is returned is to its own owner,
// behind a positive bidderId === viewerId check. Enforced by
// tests/auctionRoute.test.ts, which asserts the exact key set of every
// auction payload and drives a rival probing for it.
model AuctionProxyBid {
  auctionId String   @id
  bidderId  String
  maxAmount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation("ProxyBidder", fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([bidderId])
}

// ── PvP ladder rewards ───────────────────────────────────────────────────
// Policy + payment: server/src/lib/pvpLadder.ts. Cosmetic tiers + the
// tier-priced cash table: server/src/lib/pvpBadge.ts. DDL: the hand-written
// migration 20260730120000_add_pvp_ladder/migration.sql, which carries the full
// reasoning — these models mirror it so Prisma's view of the database stays
// accurate, and they add nothing of their own.
//
// NOTHING in this block touches User, PlayerRating, PvpMatch or PendingGrant
// beyond back-relation fields (which generate no DDL). PlayerRating in
// particular is left completely alone so there is no schema conflict with the
// concurrent PvP work, and the rating-derived badge tier needs no storage at
// all.
//
// The reward itself is NEVER written into saveData. Each row here is paired
// with a PendingGrant created in the same transaction; POST /api/saves folds
// that grant on top of the bytes the client uploads, inside the CAS
// transaction that accepts the upload. See lib/prizeGrant.ts.
//
// ┌──────────────────────────────────────────────────────────────────────┐
// │ RAW-SQL-ONLY OBJECTS — present in the database, INVISIBLE to Prisma. │
// └──────────────────────────────────────────────────────────────────────┘
// Prisma has no syntax for CHECK constraints, so it neither creates nor DROPs
// these; they live only in the migration, and this list is the only place a
// reader of the schema can learn they exist.
// tests/pvpLadderSchemaDrift.test.ts asserts every line below is still present
// in the migration SQL and that this list is still present here, so the two
// cannot silently diverge.
//
//   CHECK PvpLadderEarn_not_self          ("userId" <> "opponentUserId")
//   CHECK PvpLadderEarn_nonneg            ("bp" >= 0 AND "milestoneBp" >= 0 AND "moneyAwarded" >= 0)
//   CHECK PvpLadderEarn_money_needs_bonus ("moneyAwarded" = 0 OR "winBonusPaid")
//   CHECK PvpWinBonusClaim_nonneg         ("money" >= 0)
//   CHECK PvpBadgeMilestone_nonneg        ("bp" >= 0)
//   CHECK PvpBadgeMilestone_crossed       ("ratingBefore" < "threshold")
//
// The list above is complete, and PvpLadderBaseline (migration
// 20260730130000_add_pvp_ladder_baseline) deliberately adds nothing to it: its
// only value column is written as GREATEST() of three server-owned integers that
// are already non-negative by construction, so there is no predicate a CHECK
// could enforce that the writer does not.
//
// There is deliberately NO partial unique index anywhere in this feature.
// Prisma DOES introspect indexes and cannot express a WHERE clause, so a
// partial index is exactly the object `prisma migrate dev` would generate a
// DROP for — the additive-only policy is a convention, not a mechanism. The
// invariant an earlier version guarded that way (at most one cash bonus per
// account per period) is now held by PvpWinBonusClaim's single-row conditional
// upsert plus PvpLadderEarn_money_needs_bonus, neither of which Prisma can
// touch.

/// One row per (battle, participant). Append-only audit of what the ladder
/// MINTED — never a second authoritative balance. The spendable Battle Point
/// balance lives in the player's own save (`inventory.battlepoint`).
model PvpLadderEarn {
  id String @id

  /// Battle room id. With `userId` this is the exactly-once key: endBattle has
  /// many callers, and a replayed settle inserts zero rows and rolls back
  /// before any grant exists. Deliberately NOT a relation to PvpMatch — that
  /// insert is fire-and-forget and allowed to be dropped.
  matchId String

  userId         String
  opponentUserId String

  /// UTC calendar day. REPORTING ONLY — nothing gates on it. The cap and the
  /// decay window are both ROLLING and measured from `createdAt`, because a
  /// calendar boundary is straddleable: two matches 61 seconds apart across
  /// 00:00Z were measured paying one account $50,000, twice the advertised
  /// daily maximum.
  day DateTime @db.Date

  /// 'queue' | 'invite' — the human pairing path that built the room, asserted
  /// at construction time. THE BOT GATE'S APPLICATION HALF: a bot, tournament
  /// or admin room carries none and is refused with no code of its own.
  provenance String

  result    String /// "win" | "loss" | "tie"
  endReason String /// "ko" | "tie" — the payable allowlist

  /// Captured at payout because they are unrecoverable afterwards:
  /// PvpMatch.createdAt is stamped inside endBattle (so finishedAt - createdAt
  /// is 0 for every existing row), and the turn count exists only in room.log.
  /// `durationMs` is also the data that re-tunes LADDER_MIN_DURATION_MS from
  /// measurement instead of guesswork.
  turns      Int
  durationMs Int

  /// Both ends of the Elo move. `ratingBefore` is load-bearing: a milestone
  /// bonus is only paid on the match that CROSSES a threshold, and this is the
  /// audit of that claim.
  ratingBefore Int
  ratingAfter  Int
  ratingDelta  Int

  /// What was ACTUALLY paid, given the ledger state at that instant.
  meetingIndex  Int
  bpBeforeDecay Int
  /// The badge tier that priced the cash bonus. Cash scales with rating
  /// because Elo is zero-sum, so a collusion ring cannot manufacture it.
  tier          String

  /// CAPPED BP — battle + the once-per-cooldown bonus. The rolling cap read is
  /// SUM(bp) over the window, so this column and only this column is what the
  /// cap can see.
  bp           Int     @default(0)
  /// UNCAPPED, once-ever milestone BP, in its own column ON PURPOSE. Booking it
  /// into `bp` made a 98-BP rank-up match exhaust the 25-BP cap for every
  /// legitimate battle for the rest of that day.
  milestoneBp  Int     @default(0)
  moneyAwarded Int     @default(0)
  winBonusPaid Boolean @default(false)

  /// The PendingGrant this earn was paid through, so ops can follow an earn
  /// into `deliveredAt`. Null when the row legitimately earned zero.
  grantId String?

  createdAt DateTime @default(now())

  earner   User @relation("PvpLadderEarner", fields: [userId], references: [id], onDelete: Cascade)
  /// THE BOT GATE. A synthetic bot id violates this foreign key, Postgres
  /// raises 23503, and the whole payout transaction — both sides' rows and both
  /// grants — rolls back. A constraint rather than an if-statement, so no
  /// refactor can forget it.
  opponent User @relation("PvpLadderOpponent", fields: [opponentUserId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
  @@index([userId, opponentUserId, createdAt])
  @@index([day])
}

/// THE ATOMIC GATE for the once-per-cooldown cash bonus. ONE ROW PER ACCOUNT,
/// holding the timestamp of its last claim; the settle claims with
/// `ON CONFLICT ("userId") DO UPDATE … WHERE "claimedAt" <= now - cooldown`,
/// which takes a row lock on the existing row and so serialises concurrent
/// claims while staying exception-free (a lost race is 0 affected rows, not a
/// 23505 that would poison the transaction and cost the whole match reward).
///
/// It replaced a (userId, day) primary key, which was measured to be
/// straddleable: a calendar key is satisfiable twice by two different day
/// values, and two matches 61 seconds apart across midnight paid one account
/// $50,000. A cooldown has no boundary to sit on.
///
/// The row is overwritten on each claim: this is an arbiter, not a history. The
/// history is PvpLadderEarn.winBonusPaid + moneyAwarded, which is append-only.
model PvpWinBonusClaim {
  userId String @id
  /// The gate, compared against (now - LADDER_WIN_BONUS_COOLDOWN_MS).
  claimedAt DateTime
  /// Ops/audit only: which day and battle claimed it, and what it was priced at.
  day     DateTime @db.Date
  matchId String
  rating  Int
  tier    String
  money   Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([claimedAt])
}

/// One row per (account, rating threshold) ever crossed. NOT derivable from
/// PlayerRating: peakRating is a high-water mark, not a payment record, so an
/// oscillating rating would be paid on every crossing.
///
/// The composite id is HALF the gate. The other half is in code: a milestone is
/// paid only on the match that CROSSES the threshold
/// (`ratingBefore < threshold <= ratingAfter`, pvpBadge.milestonesCrossed).
/// Without it, rewards defaulting OFF meant the day the switch is flipped every
/// account already above a threshold would collect its whole back-catalogue —
/// the exact thing this table exists to prevent, defeated by keying on the live
/// rating instead of on the movement.
model PvpBadgeMilestone {
  userId    String
  threshold Int
  /// The rating held BEFORE the crossing match. Proof the threshold was
  /// crossed rather than merely stood above; CHECK-constrained to be below it.
  ratingBefore  Int
  ratingAtAward Int
  bp            Int
  /// Reserved; NULL for every row the current code writes. A milestone is paid
  /// inside the SAME grant as the battle that triggered it (one grant per side
  /// per battle), and that id is on the PvpLadderEarn row. Kept nullable so a
  /// future out-of-band milestone payment has somewhere to record itself
  /// without a migration.
  grantId   String?
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, threshold])
}

/// What an account had ALREADY achieved before the ladder ever paid it
/// anything. One row per account, written ONCE and never revised.
///
/// ── WHY THIS TABLE EXISTS ────────────────────────────────────────────────
/// Milestone BP is paid on the match that CROSSES a rating threshold, which
/// stops the day PVP_LADDER_REWARDS is switched on from paying every already-high
/// account its entire back-catalogue at once. It does not stop the same payout
/// arriving one loss later: an account sitting above a threshold is a single
/// defeat away from re-crossing it, and PvpBadgeMilestone's once-ever key pays
/// that first re-crossing quite happily. So "keyed on movement" bought a
/// STAGGERED retroactive dump rather than no dump.
///
/// `rating` here is the high-water mark the account had reached before rewards —
/// taken from PlayerRating."peakRating", which applyEloUpdate has maintained
/// since long before this feature existed, so the number is a record rather than
/// an estimate. lib/pvpLadder.ts refuses any threshold at or below it.
///
/// Migration 20260730130000_add_pvp_ladder_baseline backfills one row per
/// account that has ever played a rated match (4 rows in production, ratings
/// 984–1016), which is what makes the freeze exact for everybody who exists
/// today; the settle seeds one lazily for anybody who starts later.
///
/// NEVER UPDATE A ROW HERE. A baseline that follows the player upward makes
/// every subsequent milestone unpayable.
model PvpLadderBaseline {
  userId String @id
  /// The high-water rating frozen at `createdAt`. No milestone threshold at or
  /// below this can ever be paid to this account.
  rating Int
  /// 'migration' (backfilled at deploy) or 'settle' (seeded on first payout), so
  /// ops can tell an exact freeze from a conservative one.
  source    String   @default("settle")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

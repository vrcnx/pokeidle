{
  "name": "pokemon-mmo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "echo 'REFUSED: db push diffs the whole schema and can DROP live columns/tables. Prod is managed by Prisma Migrate. Use: npm run db:migrate (dev) then commit the migration -- deploy applies it via migrate deploy.' && exit 1",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push:force": "prisma db push",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@pkmn/protocol": "^0.7.2",
    "@pkmn/sim": "^0.10.7",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.1.18",
    "hono": "^4.6.14",
    "resend": "^6.12.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

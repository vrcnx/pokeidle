# ── Discord ─────────────────────────────────────────────────────────
# From https://discord.com/developers/applications → your app.
#
# The bot needs the SERVER MEMBERS INTENT enabled (Bot → Privileged Gateway
# Intents). Without it, guild.members.fetch() returns only cached members and
# role sync would silently cover a fraction of the server. It does NOT need
# Message Content — the bot never reads message text.
#
# Invite it with the `bot` and `applications.commands` scopes and the
# "Manage Roles" permission. Then drag its role ABOVE Trainer / Champion /
# Ace Trainer in Server Settings → Roles: Discord refuses any role change at
# or above the bot's own highest role.
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""

# ── Game server ─────────────────────────────────────────────────────
# Base URL of the Pokémon Idle API, no trailing slash.
API_BASE="https://api.pokeidle.com"

# Shared secret for /api/bot. MUST match BOT_TOKEN in the game server's env,
# and must be at least 32 characters — the server refuses a shorter one and
# answers 401 to everything, which looks exactly like a wrong token.
# Generate with:  openssl rand -hex 32
BOT_TOKEN=""

# ── Channels ────────────────────────────────────────────────────────
# Right-click a channel → Copy Channel ID (needs Developer Mode on).
# Leave the trade channel blank to post listings wherever the command was run.
# Leave the mod log blank to skip audit posts — the durable audit is
# AdminAudit on the game server either way.
DISCORD_TRADE_CHANNEL_ID=""
DISCORD_MOD_LOG_CHANNEL_ID=""

# ── Behaviour ───────────────────────────────────────────────────────
# Roles allowed to run /giveaway, comma-separated, matched by name.
DISCORD_ADMIN_ROLES="Admin,Moderator"

# How often to reconcile roles, in ms. Default 5 minutes.
ROLE_SYNC_INTERVAL_MS="300000"

# Set to 1 on a second (development) instance pointed at the same guild, so
# two reconcilers don't fight over the same roles.
ROLE_SYNC_DISABLED=""

# Set to 1 to stop polling for admin-dashboard giveaways. Same reason as
# ROLE_SYNC_DISABLED — two instances would both try to announce. (The server's
# NULL-guarded claim means the loser deletes its own duplicate, so this is
# tidiness rather than correctness.)
GIVEAWAY_SYNC_DISABLED=""

# How long a Discord trade listing stays up before the bot deletes it.
# Default 48h. The in-game mirror of the listing is the durable copy.
TRADE_LISTING_TTL_MS="172800000"

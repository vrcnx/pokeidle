{
  "name": "pkmn-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pokémon Idle community Discord bot: account linking, trainer cards, ladder roles, giveaways and a trade noticeboard. Talks to the game server's /api/bot surface over a shared secret; runs as its own deploy, never inside the game server process.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "deploy-commands": "tsx --env-file-if-exists=.env src/deployCommands.ts",
    "channels": "tsx --env-file-if-exists=.env scripts/channels.mts",
    "snapshot": "tsx --env-file-if-exists=.env scripts/snapshot.mts",
    "typecheck": "tsc --noEmit",
    "samples": "tsx --env-file-if-exists=.env scripts/renderSamples.mts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.mts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
